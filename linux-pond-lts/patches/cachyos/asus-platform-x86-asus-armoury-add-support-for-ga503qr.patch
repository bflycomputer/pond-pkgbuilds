From: Denis Benato <denis.benato@linux.dev>
Date: Sat, 29 Nov 2025 15:26:21 +0100
Subject: platform/x86: asus-armoury: add support for GA503QR
CachyOS-Branch: asus

# Add TDP data for laptop model GA503QR.
#
# Signed-off-by: Denis Benato <denis.benato@linux.dev>
---
diff --git a/drivers/platform/x86/asus-armoury.h b/drivers/platform/x86/asus-armoury.h
index bfa0d08ca7ee..bc8fb54c4af0 100644
--- a/drivers/platform/x86/asus-armoury.h
+++ b/drivers/platform/x86/asus-armoury.h
@@ -969,6 +969,20 @@ static const struct dmi_system_id power_limits[] = {
 			.requires_fan_curve = true,
 		},
 	},
+	{
+		.matches = {
+			DMI_MATCH(DMI_BOARD_NAME, "GA503QR"),
+		},
+		.driver_data = &(struct power_data) {
+			.ac_data = &(struct power_limits) {
+				.ppt_pl1_spl_min = 15,
+				.ppt_pl1_spl_def = 35,
+				.ppt_pl1_spl_max = 80,
+				.ppt_pl2_sppt_min = 65,
+				.ppt_pl2_sppt_max = 80,
+			},
+		},
+	},
 	{
 		.matches = {
 			DMI_MATCH(DMI_BOARD_NAME, "GA503R"),
