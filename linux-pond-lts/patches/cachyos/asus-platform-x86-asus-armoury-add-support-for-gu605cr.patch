From: Denis Benato <denis.benato@linux.dev>
Date: Thu, 25 Dec 2025 03:38:41 +0100
Subject: platform/x86: asus-armoury: add support for GU605CR
CachyOS-Branch: asus

# Add TDP data for laptop model GU605CR.
#
# Signed-off-by: Denis Benato <denis.benato@linux.dev>
# Link: https://patch.msgid.link/20251225023841.1970513-1-denis.benato@linux.dev
# Reviewed-by: Ilpo Järvinen <ilpo.jarvinen@linux.intel.com>
# Signed-off-by: Ilpo Järvinen <ilpo.jarvinen@linux.intel.com>
---
diff --git a/drivers/platform/x86/asus-armoury.h b/drivers/platform/x86/asus-armoury.h
index 40fcd7c04b73..d5c193f74d02 100644
--- a/drivers/platform/x86/asus-armoury.h
+++ b/drivers/platform/x86/asus-armoury.h
@@ -936,6 +936,35 @@ static const struct dmi_system_id power_limits[] = {
