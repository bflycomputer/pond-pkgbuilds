From: Peter Jung <admin@ptr1337.dev>
Date: Mon, 2 Nov 2026 15:32:12 +0100
Subject: fixup! drivers/pci: Add ACS override support
CachyOS-Branch: cachy

# Put the ACS override behind CONFIG_PCI_ACS_OVERRIDE, so kernels that need
# IOMMU groups matching the hardware isolation can leave it out.
#
# Signed-off-by: Peter Jung <admin@ptr1337.dev>
---
diff --git a/Documentation/admin-guide/kernel-parameters.txt b/Documentation/admin-guide/kernel-parameters.txt
index 50c11b8a0f5f..c2eb2bd0c269 100644
--- a/Documentation/admin-guide/kernel-parameters.txt
+++ b/Documentation/admin-guide/kernel-parameters.txt
@@ -5114,6 +5114,7 @@ Kernel parameters
 				id:nnnn:nnnn
 					Specfic device - full ACS capabilities
 					Specified as vid:did (vendor/device ID) in hex
+				Only available with CONFIG_PCI_ACS_OVERRIDE=y.
 		noioapicquirk	[APIC] Disable all boot interrupt quirks.
 				Safety option to keep boot IRQs enabled. This
 				should never be necessary.
diff --git a/drivers/pci/Kconfig b/drivers/pci/Kconfig
index 0c7408509ba2..f2f3f79c150e 100644
--- a/drivers/pci/Kconfig
+++ b/drivers/pci/Kconfig
@@ -67,6 +67,22 @@ config PCI_QUIRKS
 	  Disable this only if your target machine is unaffected by PCI
 	  quirks.
 
+config PCI_ACS_OVERRIDE
+	bool "Allow overriding missing PCIe ACS support"
+	depends on PCI_QUIRKS
+	default y
+	help
+	  This adds the pcie_acs_override= kernel parameter, which treats
+	  PCIe ports and devices without ACS as if they isolate peer-to-peer
+	  DMA. It splits IOMMU groups, for example to pass a single device
+	  to a virtual machine, but the hardware still allows peer-to-peer
+	  DMA that is not translated by the IOMMU.
+
+	  Say N if the IOMMU groups have to match the isolation the hardware
+	  actually provides.
+
+	  If unsure, say Y.
+
 config PCI_DEBUG
 	bool "PCI Debugging"
 	depends on DEBUG_KERNEL
diff --git a/drivers/pci/quirks.c b/drivers/pci/quirks.c
index 276c34e33c7b..1dff2c4fc708 100644
--- a/drivers/pci/quirks.c
+++ b/drivers/pci/quirks.c
@@ -3782,6 +3782,7 @@ static void quirk_no_bus_reset(struct pci_dev *dev)
 	dev->dev_flags |= PCI_DEV_FLAGS_NO_BUS_RESET;
 }
 
+#ifdef CONFIG_PCI_ACS_OVERRIDE
 static bool acs_on_downstream;
 static bool acs_on_multifunction;
 
@@ -3882,6 +3883,8 @@ static int pcie_acs_overrides(struct pci_dev *dev, u16 acs_flags)
 
 	return -ENOTTY;
 }
+#endif /* CONFIG_PCI_ACS_OVERRIDE */
+
 /*
  * After asserting Secondary Bus Reset to downstream devices via a GB10
  * Root Port, the link may not retrain correctly.
@@ -5380,7 +5383,9 @@ static const struct pci_dev_acs_enabled {
 	{ PCI_VENDOR_ID_ZHAOXIN, PCI_ANY_ID, pci_quirk_zhaoxin_pcie_ports_acs },
 	/* Wangxun nics */
 	{ PCI_VENDOR_ID_WANGXUN, PCI_ANY_ID, pci_quirk_wangxun_nic_acs },
+#ifdef CONFIG_PCI_ACS_OVERRIDE
 	{ PCI_ANY_ID, PCI_ANY_ID, pcie_acs_overrides },
+#endif
 	{ 0 }
 };
 
