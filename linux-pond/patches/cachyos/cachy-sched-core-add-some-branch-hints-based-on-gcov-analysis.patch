From: Colin Ian King <colin.i.king@intel.com>
Date: Mon, 17 Mar 2025 12:03:19 +0000
Subject: sched/core: add some branch hints based on gcov analysis
CachyOS-Branch: cachy

# Patch refreshed for v6.13.7
#
# Signed-off-by: Colin Ian King <colin.i.king@intel.com>
---
diff --git a/kernel/sched/core.c b/kernel/sched/core.c
index 1754d9f95f2c..5d38537dd751 100644
--- a/kernel/sched/core.c
+++ b/kernel/sched/core.c
@@ -673,7 +673,7 @@ void raw_spin_rq_lock_nested(struct rq *rq, int subclass)
 
 	/* Matches synchronize_rcu() in __sched_core_enable() */
 	preempt_disable();
-	if (sched_core_disabled()) {
+	if (likely(sched_core_disabled())) {
 		raw_spin_lock_nested(&rq->__lock, subclass);
 		/* preempt_count *MUST* be > 1 */
 		preempt_enable_no_resched();
@@ -885,7 +885,7 @@ void update_rq_clock(struct rq *rq)
 	scx_rq_clock_update(rq, clock);
 
 	delta = clock - rq->clock;
-	if (delta < 0)
+	if (unlikely(delta < 0))
 		return;
 	rq->clock += delta;
 
@@ -6254,7 +6254,7 @@ pick_next_task(struct rq *rq, struct rq_flags *rf)
 	struct rq *rq_i;
 	bool need_sync = false;
 
-	if (!sched_core_enabled(rq))
+	if (likely(!sched_core_enabled(rq)))
 		return __pick_next_task(rq, rf);
 
 	cpu = cpu_of(rq);
@@ -7802,7 +7802,7 @@ out_unlock:
 #if !defined(CONFIG_PREEMPTION) || defined(CONFIG_PREEMPT_DYNAMIC)
 int __sched __cond_resched(void)
 {
-	if (should_resched(0) && !irqs_disabled()) {
+	if (unlikely(should_resched(0) && !irqs_disabled())) {
 		preempt_schedule_common();
 		return 1;
 	}
