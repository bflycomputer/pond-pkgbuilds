# Export rules: unmatched commits are kept; 'keep' overrides exclusions.
#
#   drop-branch <name>   Exclude a topic branch.
#   drop <glob>          Exclude matching commit subjects.
#   keep <glob>          Retain matching commit subjects.

# Mac and T2 support.
drop-branch t2
# Mainline backport: 6f88e6ebdc1a.
keep wifi: brcmfmac: Improve D3 substate entering timeout handling

# BBRv3.
drop-branch bbr3

# Samsung Galaxy Book speaker support.
drop-branch snd-codecs

