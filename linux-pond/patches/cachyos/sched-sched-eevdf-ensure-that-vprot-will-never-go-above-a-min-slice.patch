From: Vincent Guittot <vincent.guittot@linaro.org>
Date: Mon, 21 Sep 2026 17:22:31 +0200
Subject: sched/eevdf: Ensure that vprot will never go above a min slice
CachyOS-Branch: sched

# ineligible_vruntime() can be after the duration of a min slice but we
# want to make sure that current will not run more than a min slice.
#
# Signed-off-by: Vincent Guittot <vincent.guittot@linaro.org>
# Signed-off-by: Peter Zijlstra (Intel) <peterz@infradead.org>
# Link: https://patch.msgid.link/20260921152238.3804392-2-vincent.guittot@linaro.org
# (cherry picked from commit aae2a33ea66299f39252bc1891bb4f05f631255d)
---
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index e413fdc70243..ad89e34b7dbc 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -1146,10 +1146,9 @@ static inline void set_protect_slice(struct cfs_rq *cfs_rq, struct sched_entity
 
 	/* If there are shorter slices than se's one */
 	if (slice != se->slice) {
+		vprot = min_vruntime(vprot, se->vruntime + calc_delta_fair(slice, se));
 		if (sched_feat(PREEMPT_SHORT))
 			vprot = min_vruntime(vprot, ineligible_vruntime(cfs_rq));
-		else
-			vprot = min_vruntime(vprot, se->vruntime + calc_delta_fair(slice, se));
 	}
 
 	se->vprot = vprot;
