From: Vincent Guittot <vincent.guittot@linaro.org>
Date: Mon, 21 Sep 2026 17:22:33 +0200
Subject: sched/eevdf: Handle more short slice waking cases
CachyOS-Branch: sched

# Handle better the cases with several short slice tasks waking up
# simultaneously.
#
# Signed-off-by: Vincent Guittot <vincent.guittot@linaro.org>
# Signed-off-by: Peter Zijlstra (Intel) <peterz@infradead.org>
# Link: https://patch.msgid.link/20260921152238.3804392-4-vincent.guittot@linaro.org
# (cherry picked from commit d2e0100827578641df2f85546bdb57bb1d8ff55b)
---
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index b85dccf76410..756b5bdb6b2c 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -10094,8 +10094,14 @@ static inline bool set_preempt_buddy(struct cfs_rq *cfs_rq, struct sched_entity
 
 static inline bool set_short_buddy(struct cfs_rq *cfs_rq, struct sched_entity *pse)
 {
-	if (cfs_rq->next && cfs_rq->next->slice < pse->slice)
-		return false;
+	if (cfs_rq->next) {
+		if (cfs_rq->next->slice < pse->slice)
+			return false;
+
+		if (cfs_rq->next->slice == pse->slice &&
+		    entity_before(cfs_rq->next, pse))
+			return false;
+	}
 
 	set_next_buddy(cfs_rq, pse);
 	return true;
